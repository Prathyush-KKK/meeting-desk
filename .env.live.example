# The Mac launch: copy to .env, fill the two Google values, run scripts/mac-launch.sh.
# docker-compose.live.yml fixes everything else (real Google, no dev user, the SPA served by the
# API). Never commit .env.

# --- who gets in ------------------------------------------------------------------------------
# Put on the allow-list as admins at every start. The first person to sign in has to be here;
# everyone after that is added on the Admin page.
BOOTSTRAP_ADMINS=prathyush.kodhanpur@simpleo.ai
GOOGLE_HOSTED_DOMAIN=simpleo.ai

# --- the OAuth client (README: "GCP project setup") ---------------------------------------------
# A Web client on an Internal consent screen, with these two redirect URIs registered:
#   http://localhost:8000/auth/callback
#   http://localhost:8000/admin/connections/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- generated by scripts/mac-launch.sh when empty ----------------------------------------------
SESSION_SECRET=
MEETING_DESK_TOKEN_KEY=
MEETING_DESK_TOKEN_KEY_VERSION=1

# --- extraction -------------------------------------------------------------------------------
# FAKE_LLM=1: the rule-based extractor, nothing to configure.
# FAKE_LLM=0 with EXTRACTION_PROVIDER=bedrock: a Claude model on Bedrock (ap-south-1). The image
# is rebuilt with the boto3 extra by scripts/mac-launch.sh. Credentials: paste an access key pair
# below (never committed: .env is git-ignored), or leave them empty and put a profile's keys in
# the same two variables from your shell before running the script. BEDROCK_MODEL must be a model
# id or inference profile id that is enabled under Bedrock > Model access in that region.
# EXTRACTION_PROVIDER=vertex instead needs VERTEX_PROJECT, a service-account JSON at
# ./secrets/vertex-key.json mounted into the container, and the vertex extra.
FAKE_LLM=1
EXTRACTION_PROVIDER=fake
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-south-1
EXTRACT_FALLBACK_TO_BEDROCK=0
VERTEX_PROJECT=
VERTEX_LOCATION=asia-south1
VERTEX_MODEL=gemini-2.5-flash

# --- where it answers -------------------------------------------------------------------------
# 127.0.0.1 keeps it on this machine. To reach it from the phone over Tailscale, set BIND_HOST to
# 0.0.0.0, PUBLIC_URL to http://<tailscale-name>:8000 and add the two callback URIs for that host
# to the OAuth client.
BIND_HOST=127.0.0.1
PUBLIC_URL=http://localhost:8000
POSTGRES_PASSWORD=meetingdesk
LOG_LEVEL=INFO
