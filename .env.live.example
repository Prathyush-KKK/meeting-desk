# The live launch: Meeting Desk with your real Google account, on your own machine.
# Copy to .env, fill in BOOTSTRAP_ADMINS and the two Google values, then run scripts/live.sh.
# docker-compose.live.yml fixes everything else (real Google, no dev user, the SPA served by the
# API). Never commit .env.

# --- who gets in ------------------------------------------------------------------------------
# Put on the allow-list as admins at every start. The first person to sign in has to be here;
# everyone after that is added on the Admin page.
BOOTSTRAP_ADMINS=you@example.com
# Only accounts of this Google Workspace domain may sign in. Leave empty for any Google account.
GOOGLE_HOSTED_DOMAIN=
# A personal Gmail account: set both to 0. Gmail is a restricted scope and there is no directory.
GOOGLE_USE_GMAIL=1
GOOGLE_USE_DIRECTORY=1
# Every time is shown in this zone (an IANA name, e.g. Europe/London, America/New_York).
DISPLAY_TIMEZONE=UTC
# The workstreams offered on a meeting, comma-separated.
WORKSTREAMS=Product,Engineering,Design,Growth,Operations,Hiring

# --- the OAuth client (README: "GCP project setup") ---------------------------------------------
# A Web client on an Internal consent screen, with these two redirect URIs registered:
#   http://localhost:8000/auth/callback
#   http://localhost:8000/admin/connections/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- generated by scripts/live.sh when empty ----------------------------------------------
SESSION_SECRET=
MEETING_DESK_TOKEN_KEY=
MEETING_DESK_TOKEN_KEY_VERSION=1

# --- extraction -------------------------------------------------------------------------------
# FAKE_LLM=1: the rule-based extractor, nothing to configure. To use a real model, set FAKE_LLM=0
# and pick one EXTRACTION_PROVIDER below. Keys are secrets: .env is git-ignored, or export them
# from your shell instead.
FAKE_LLM=1
EXTRACTION_PROVIDER=fake
#
# openai - any OpenAI-compatible endpoint, no SDK needed:
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_API_KEY=sk-...   LLM_MODEL=gpt-4.1-mini
#   Ollama:      LLM_BASE_URL=http://host.docker.internal:11434/v1            LLM_MODEL=llama3.1
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=...    LLM_MODEL=<vendor/model>
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
#
# anthropic - Claude through the Anthropic API (scripts/live.sh builds the image with the SDK):
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
#
# bedrock - Bedrock's OpenAI-compatible endpoint with a Bedrock API key (no SDK needed) ...
#   BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
#   AWS_BEARER_TOKEN_BEDROCK=<the key>
#   BEDROCK_MODEL_ID=<a model id offered there>
BEDROCK_BASE_URL=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=
# Read timeout on one completion, seconds (default 180); a run that passes it is recorded on the
# meeting as a failed extraction.
# BEDROCK_TIMEOUT_SECONDS=180
#
# ... or, when the two above are empty, an access key pair and the Converse API in BEDROCK_REGION
# (scripts/live.sh rebuilds the image with the boto3 extra for it). BEDROCK_MODEL must be a model id
# or inference profile id enabled under Bedrock > Model access in that region.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
#
# vertex - Gemini on Vertex AI: VERTEX_PROJECT, a service-account JSON at ./secrets/vertex-key.json
# mounted into the container, and the vertex extra. With EXTRACT_FALLBACK_TO_BEDROCK=1 a Vertex
# failure is retried on Bedrock, chosen the same way.
EXTRACT_FALLBACK_TO_BEDROCK=0
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# --- notifications ----------------------------------------------------------------------------
# A Slack, Google Chat or Mattermost incoming-webhook URL (Discord: add /slack): each transfer posts
# a summary of what was written where.
NOTIFY_WEBHOOK_URL=

# --- where it answers -------------------------------------------------------------------------
# 127.0.0.1 keeps it on this machine. To reach it from another device (e.g. over Tailscale), set
# BIND_HOST to 0.0.0.0, PUBLIC_URL to http://<host-name>:8000 and add the two callback URIs for that
# host to the OAuth client.
BIND_HOST=127.0.0.1
PUBLIC_URL=http://localhost:8000
POSTGRES_PASSWORD=meetingdesk
LOG_LEVEL=INFO

# The meeting list shows the calendar from CALENDAR_LOOKBACK_DAYS back to CALENDAR_LOOKAHEAD_DAYS
# ahead (defaults 30 and 14). Captured meetings stay on the list whatever their date.
# CALENDAR_LOOKBACK_DAYS=30
# CALENDAR_LOOKAHEAD_DAYS=14
