# The web app on its own, behind nginx. NOT what the chart deploys - see the note below.
#
# The decision: the SPA ships inside the API image (deploy/Dockerfile.api builds it in
# its first stage and copies `dist` in as WEB_DIST). Reasons, in order:
#
#   1. main.py already serves it. `mount_web` puts `web/dist` at "/" behind the routers with an
#      SPA fallback, so a second web server adds a hop and no capability.
#   2. One origin means the session cookie needs no CORS exception and no SameSite juggling.
#   3. One image means one tag to move per release and one thing that can be out of step.
#
# This file is kept because a split deployment is a real option - a CDN in front, or the app served
# from a different host than the API - and because it is cheaper to keep it working than to
# reconstruct it later. To use it: build both images, set `VITE_API_BASE` at build time to the
# API's origin, add `CORS_ORIGINS=["https://<web host>"]` on the API, and point a second Ingress
# rule at this Service.
#
#   docker build -f deploy/Dockerfile.web -t meeting-desk-web:dev .

FROM node:22-alpine AS build
WORKDIR /src/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
# Empty means "same origin", which is what the single-image route uses; set it for a split one.
ARG VITE_API_BASE=""
ENV VITE_API_BASE=$VITE_API_BASE
RUN pnpm run build

FROM nginxinc/nginx-unprivileged:1.31-alpine AS runtime
# The unprivileged image already runs as uid 101 and listens on 8080.
COPY --from=build /src/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/bin/sh", "-c", "wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1"]
