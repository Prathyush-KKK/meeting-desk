# Copy to .env. Nothing here is a real credential and nothing here should ever become one:
# deployments read secrets from a secret manager (the Helm chart uses External Secrets), not a file.

# --- core ---------------------------------------------------------------------------------------
# Anything but "local" or "test" is a deployment: the app then refuses to start with the default
# SESSION_SECRET, with one shorter than 32 characters, with AUTH_DEV_USER set, or with "*" in
# CORS_ORIGINS, and the OAuth state cookie is set Secure.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://meetingdesk:meetingdesk@localhost:5432/meetingdesk
CORS_ORIGINS=["http://localhost:5173"]

# --- fakes --------------------------------------------------------------------------------------
# With both on, the whole backend runs with no network and no credentials. This is phase 1.
FAKE_GOOGLE=1
FAKE_LLM=1
SEED_DEMO=1

# --- auth ---------------------------------------------------------------------------------------
# AUTH_DEV_USER signs every request in as this email (the demo world's admin) without touching Google. Local and tests only;
# leave it empty in any deployment.
AUTH_DEV_USER=daniel.okafor@example.com
# 32 characters or more in a deployment; `make token-key` prints something long enough.
SESSION_SECRET=change-me-locally
# The OAuth "state" round trip, on its own short-lived cookie.
STATE_COOKIE=md_oauth_state
STATE_COOKIE_MAX_AGE_SECONDS=600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# Only accounts of this Google Workspace domain may sign in; empty allows any Google account.
GOOGLE_HOSTED_DOMAIN=
WEB_BASE_URL=http://localhost:5173
# The built web app. Empty: the API is API-only and Vite serves the app on :5173. Set to web/dist
# and the API serves it at "/" with an SPA fallback, so one container answers both.
WEB_DIST=

# --- admin connections (FAKE_GOOGLE=0) -----------------------------------------------------------
# The same internal OAuth client as sign-in, with the connect callback registered as a second
# redirect URI. MEETING_DESK_TOKEN_KEY encrypts the refresh tokens at rest: `make token-key`.
GOOGLE_CONNECT_REDIRECT_URI=http://localhost:8000/admin/connections/callback
MEETING_DESK_TOKEN_KEY=
MEETING_DESK_TOKEN_KEY_VERSION=1
# During a rotation: the key being retired. Drop it after `POST /admin/connections/rotate-keys`.
MEETING_DESK_TOKEN_KEY_PREVIOUS=
# Google API behaviour (defaults are fine)
GOOGLE_API_TIMEOUT_SECONDS=30
GOOGLE_MAX_RETRIES=5
GOOGLE_BACKOFF_BASE_SECONDS=0.5
GOOGLE_CONNECTION_BACKOFF_SECONDS=60
SHEETS_MAX_ROWS=5000

# --- display ------------------------------------------------------------------------------------
DISPLAY_TIMEZONE=UTC
WORKSTREAMS=Product,Engineering,Design,Growth,Operations,Hiring

# --- extraction (FAKE_LLM=0) --------------------------------------------------------------------
# fake | openai | anthropic | vertex | bedrock | bedrock_openai
EXTRACTION_PROVIDER=fake
# openai: any OpenAI-compatible endpoint (OpenAI, Ollama http://localhost:11434/v1, OpenRouter, ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# anthropic: Claude (pip install '.[anthropic]')
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
EXTRACT_FALLBACK_TO_BEDROCK=0
EXTRACTION_MAX_OUTPUT_TOKENS=8192

# --- telemetry (docs/TELEMETRY.md) ----------------------------------------------------------------
# /metrics is served by a second ASGI app on its own port, never on the API's router or its port,
# so the public ingress cannot reach it. The chart names this port `metrics` on the Service and the
# ServiceMonitor references it by that name.
METRICS_ENABLED=1
METRICS_PORT=9464
METRICS_HOST=0.0.0.0
LOG_LEVEL=INFO
# Both land on app_build_info{version,commit}; CI sets them per build.
APP_VERSION=0.1.0
GIT_COMMIT=unknown

# --- jobs (procrastinate on Postgres) -----------------------------------------------------------
# Off: extraction runs inline in the request. On: the API enqueues and `make worker` runs the
# tasks (extraction, the Doc re-check every 5 minutes, token health daily). Needs Postgres and
# `make jobs-schema` once.
JOBS_ENABLED=0
JOBS_DATABASE_URL=
